@PACKAGE_INIT@

set(xgen_bytes_VERSION "@PROJECT_VERSION@")
include("${CMAKE_CURRENT_LIST_DIR}/xgen_bytesCheckTarget.cmake")
set(_xgb_components "${xgen_bytes_FIND_COMPONENTS}")
if(NOT _xgb_components)
    set(_xgb_components bytes)
endif()
foreach(_xgb_component IN LISTS _xgb_components)
    set(xgen_bytes_${_xgb_component}_FOUND FALSE)
    if(NOT _xgb_component STREQUAL "bytes")
        set(xgen_bytes_NOT_FOUND_MESSAGE
            "xgen-bytes component '${_xgb_component}' is not available; available: bytes")
        continue()
    endif()
    if(NOT TARGET xgb::bytes)
        include("${CMAKE_CURRENT_LIST_DIR}/xgenBytesTargets.cmake")
    endif()
    xgb_check_target(xgb::bytes "@PROJECT_VERSION@" "@XGB_ABI_VERSION@" _xgb_error)
    if(_xgb_error)
        set(xgen_bytes_NOT_FOUND_MESSAGE "${_xgb_error}")
        set(xgen_bytes_FOUND FALSE)
        return()
    endif()
    set(xgen_bytes_bytes_FOUND TRUE)
endforeach()
check_required_components(xgen_bytes)
unset(_xgb_components)
unset(_xgb_component)
unset(_xgb_error)
